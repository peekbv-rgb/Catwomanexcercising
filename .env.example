# Kopieer dit bestand lokaal naar .env en vul je echte sleutels in.
# Zet .env nooit op GitHub.

# Nodig voor full-body Motion Control:
KLING_API_KEY=your_kling_api_key_here

# Optioneel: nodig voor automatisch A-E genereren en/of AI voice-over:
RUNWAYML_API_SECRET=your_runway_api_key_here

# Alleen gebruiken als Kling de endpoint-configuratie wijzigt:
# KLING_API_BASE_URL=https://api.klingai.com
# KLING_MOTION_PATH=/v1/videos/motion-control
